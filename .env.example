# LLM Worker -- environment variables (per Worker host). Key names only, no real values.
# See README.md §5 (Configuration reference) for defaults/validation of every one of these, and
# AIReviewGateway's DEPLOYMENT.md §7.3 (cross-repo coupling table) for what must match the Gateway side.

# --- required; no default, WorkerProperties fails startup fast without them ---
GATEWAY_URL=                  # e.g. https://gateway.internal -- https:// required unless loopback
GATEWAY_API_KEY=              # must equal the Gateway's own WORKER_TOKEN value
WORKER_ID=                    # e.g. worker-llama-01 -- self-chosen, unique per Worker process
BACKEND_ID=                   # must equal a backends.name row already seeded in the Gateway DB
LLAMA_URL=                    # this host's own llama-server, e.g. http://127.0.0.1:8000
LLAMA_MODEL=                  # model name sent to llama-server and reported back to the Gateway

# --- optional; defaults live in Dockerfile ENV / application.yml, only set what you're changing ---
LLAMA_MAX_TOKENS=12000
LLAMA_ENABLE_THINKING=true
# WORKER_HEARTBEAT_INTERVAL_SEC=60
# WORKER_MAX_CONSTRAINT_BYTES=69632

# Backend Self-Registration: optional, unset by default -- its presence is the ONLY toggle for whether
# this Worker announces itself to the Gateway (POST /backends/announce) before polling for jobs. This is
# the address the GATEWAY reaches this backend at (a LAN address), NOT LLAMA_URL above (where this Worker
# process itself connects). Must be a bare origin (scheme://host[:port], no path/query/fragment/userinfo)
# and not loopback -- WorkerProperties fails startup fast otherwise. Requires the Gateway's own
# gateway.backend.self-registration.enabled=true and a matching allowed-host-pattern; see the Gateway's
# DEPLOYMENT.md. Leave unset to keep registering this backend via the Gateway's admin API or SQL instead.
# BACKEND_URL=

# --- dev-only loopback escape hatch -- DO NOT set this for a remote Gateway. ---
# A non-loopback GATEWAY_URL always requires https:// regardless of this flag (WorkerProperties).
# Forwarding loopback to a remote Gateway through a non-encrypting relay (socat, a plain proxy_pass,
# a published-port shim) is FORBIDDEN even with this flag set -- see docker-compose.yml's comment
# block and README.md §6 for the acceptable alternative (an encrypting tunnel: ssh -L, WireGuard, mTLS).
# WORKER_ALLOW_INSECURE_GATEWAY=true
