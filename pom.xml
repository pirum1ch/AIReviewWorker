<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone Maven project, NOT a module of the root Gateway pom.xml (docs/worker-architecture.md
         §11: "worker/pom.xml # Spring Boot 4.1.2 parent, standalone (not a root module)"). Built and
         tested independently: `cd worker && mvn test`. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Boot 4.1.2 → Spring Framework 7.0.10 (fixes CVSS-9.8 CVEs in spring-webmvc: GHSA-j9f9-w8pj-32f8,
             GHSA-pc63-qcmh-9cmg — fixed only in 7.0.9+). Boot 3.5.x reached OSS EOL (2026-06-30); 4.1.x
             is the active supported line (OSS to 2027-07-31). -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.review</groupId>
    <artifactId>llm-worker</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>llm-worker</name>
    <description>Stateless transport agent between Review Gateway and a local llama-server instance.</description>

    <properties>
        <java.version>21</java.version>
        <mockwebserver.version>4.12.0</mockwebserver.version>
        <!-- Spring Boot 4.x uses tools.jackson:jackson-bom (Jackson 5.x / Jakarta EE 11) natively.
             No explicit property needed — Boot manages the version. -->
        <!-- logback 1.5.35: fixes GHSA-jhq6-gfmj-v8fx (Boot's standard override property still works in 4.x). -->
        <logback.version>1.5.35</logback.version>
        <logback.version>1.5.35</logback.version>
        <!-- Boot 4.1.2 manages Tomcat 11.x natively (no explicit pin needed). -->
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <!-- Web: RestClient (approved stack), and needed to serve /actuator/prometheus + /actuator/health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator + Micrometer/Prometheus: the six worker_* metrics (D8, architecture §8). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Bean Validation on WorkerProperties (basic per-field constraints; cross-field/fail-fast
             rules that JSR-380 cannot express live in WorkerProperties' own @PostConstruct, mirroring
             the Gateway's GatewayProperties.validateOnStartup() pattern). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- SnakeYAML: already an indirect dependency of every Spring Boot app (used internally to load
             application.yml), declared directly here (version BOM-managed by the Boot parent) so
             PromptTemplateService can parse src/main/resources/prompts/<version>.yml without adding an
             unrelated new YAML-mapping library. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- ===== TEST ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- JUnit 5, Mockito, AssertJ, MockRestServiceServer support for RestClient. -->
        </dependency>

        <!-- okhttp MockWebServer: real-socket HTTP server for LlamaClient tests (parsing, 5xx, oversize
             bodies); no Docker/Testcontainers on this machine. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${mockwebserver.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>llm-worker</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Executable fat JAR (spec: "Сборка Maven (fat JAR)"). -->
            </plugin>
        </plugins>
    </build>
</project>
